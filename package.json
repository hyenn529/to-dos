{
  "name": "haru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "하루 — 둘이 같이 쓰는 to-do. 달력이 늘 곁에 있고, 시간표는 없다.",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace @haru/server",
    "dev:web": "npm run dev --workspace @haru/web",
    "build": "npm run build --workspace @haru/web",
    "start": "npm run start --workspace @haru/server",
    "test": "npm test --workspace @haru/server",
    "typecheck": "npm run typecheck --workspace @haru/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
