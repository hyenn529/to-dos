# 세션 쿠키 서명 키. 16자 이상의 임의 문자열.
# 운영에서는 반드시 지정해야 하며(없으면 서버가 뜨지 않는다), 바꾸면 모든 로그인이 풀린다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HARU_SECRET=

# SQLite 파일 경로. 비워 두면 ./data/haru.db.
# 컨테이너로 띄운다면 이 경로를 볼륨에 두어야 데이터가 남는다.
HARU_DB_PATH=

# 듣는 포트와 주소
PORT=4000
HOST=0.0.0.0

# production 으로 두면 쿠키가 secure 로 나가므로 HTTPS 뒤에서만 쓴다.
NODE_ENV=production
