# ─────────────────────────────────────────────────────────────
# 필수 — 어디에 올리든
# ─────────────────────────────────────────────────────────────

# 세션 쿠키 서명 키. 16자 이상의 임의 문자열.
# 없으면 운영에서 서버가 뜨지 않고, 바꾸면 모든 로그인이 풀린다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HARU_SECRET=


# ─────────────────────────────────────────────────────────────
# 배포 — Turso 에 저장할 때 (Vercel 등 서버리스)
# 이 둘이 있으면 자동으로 Turso 를 쓴다. 없으면 아래 로컬 파일을 쓴다.
# ─────────────────────────────────────────────────────────────

# turso db show <이름> --url  → libsql://... 형태
TURSO_DATABASE_URL=

# turso db tokens create <이름>
TURSO_AUTH_TOKEN=


# ─────────────────────────────────────────────────────────────
# 로컬 — 파일 하나에 저장할 때
# ─────────────────────────────────────────────────────────────

# SQLite 파일 경로. 비워 두면 ./data/haru.db
HARU_DB_PATH=

PORT=4000
HOST=0.0.0.0

# production 으로 두면 쿠키가 secure 로 나가므로 HTTPS 뒤에서만 쓴다.
# Vercel 은 알아서 production 으로 설정한다.
NODE_ENV=
